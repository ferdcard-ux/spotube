<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: no touchscreen, Leanback is optional so the same APK installs on phones. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application android:banner="@drawable/ic_banner">

        <!--
          TV entry point. The app manifest keeps the phone LAUNCHER activity; the manifest
          merger adds this LEANBACK_LAUNCHER activity to the single APK under the same
          applicationId, signature and DataStore.
        -->
        <activity
            android:name=".MainActivityTv"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Spotube.Tv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
