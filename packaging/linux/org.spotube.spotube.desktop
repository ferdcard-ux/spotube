[Desktop Entry]
Type=Application
Name=Spotube
GenericName=Music Player
Comment=Open source, plugin powered music streaming client
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 spotube %U
Icon=org.spotube.spotube
Terminal=false
Categories=AudioVideo;Audio;Music;Player;
